<Project>
  <!-- Configuración común a todos los proyectos de la solución FragGuard -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- libyara nativa (dnYara.NativePack) se distribuye para x64: fijamos la arquitectura -->
    <PlatformTarget>x64</PlatformTarget>
    <Company>FragGuard</Company>
    <Product>FragGuard</Product>
    <Version>0.1.0</Version>
    <Copyright>FragGuard</Copyright>
  </PropertyGroup>
</Project>
