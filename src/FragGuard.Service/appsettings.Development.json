{
  // Solo se usa al ejecutar con "dotnet run" (DOTNET_ENVIRONMENT=Development), NUNCA en el servicio instalado.
  // Permite probar el servicio como consola sin ser administrador:
  //  - datos en una carpeta local en vez de %ProgramData%\FragGuard
  //  - sin endurecer la ACL (si no, el usuario perdería el acceso a su propia carpeta de pruebas)
  //  - sin exigir administrador para cambiar la configuración desde la UI
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    }
  },
  "FragGuard": {
    "DataRoot": "devdata",
    "HardenDataDirectoryAcl": false,
    "RequireAdminForSensitiveOperations": false
  }
}
