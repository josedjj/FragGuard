<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== Paleta FragGuard (oscuro + neón) ===================== -->
    <Color x:Key="BgColor">#FF080B12</Color>
    <Color x:Key="SurfaceColor">#FF0F1420</Color>
    <Color x:Key="Surface2Color">#FF151C2B</Color>
    <Color x:Key="Surface3Color">#FF1C2538</Color>
    <Color x:Key="BorderColor">#FF223049</Color>
    <Color x:Key="AccentColor">#FF00E5FF</Color>      <!-- cian neón: color principal -->
    <Color x:Key="Accent2Color">#FFFF2E88</Color>     <!-- magenta neón: acento secundario -->
    <Color x:Key="OkColor">#FF2BFF88</Color>
    <Color x:Key="WarnColor">#FFFFB020</Color>
    <Color x:Key="DangerColor">#FFFF3B5C</Color>
    <Color x:Key="TextColor">#FFE6EDF7</Color>
    <Color x:Key="TextDimColor">#FF8A97AD</Color>
    <Color x:Key="TextFaintColor">#FF55627A</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3Color}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="Accent2Brush" Color="{StaticResource Accent2Color}" />
    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}" />
    <SolidColorBrush x:Key="TextFaintBrush" Color="{StaticResource TextFaintColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2200E5FF" />
    <SolidColorBrush x:Key="Accent2SoftBrush" Color="#22FF2E88" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#22FF3B5C" />
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#22FFB020" />
    <SolidColorBrush x:Key="OkSoftBrush" Color="#222BFF88" />

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource AccentColor}" Offset="0" />
        <GradientStop Color="{StaticResource Accent2Color}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="NavGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF0C111B" Offset="0" />
        <GradientStop Color="#FF080B12" Offset="1" />
    </LinearGradientBrush>

    <!-- ===================== Tipografía ===================== -->
    <!-- Bahnschrift viene con Windows 10/11: condensada y "técnica", ideal para titulares gamer -->
    <FontFamily x:Key="HeadingFont">Bahnschrift</FontFamily>
    <FontFamily x:Key="BodyFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <!-- ===================== Efectos de brillo (glow) ===================== -->
    <DropShadowEffect x:Key="GlowAccent" Color="{StaticResource AccentColor}" BlurRadius="18" ShadowDepth="0" Opacity="0.55" />
    <DropShadowEffect x:Key="GlowAccent2" Color="{StaticResource Accent2Color}" BlurRadius="18" ShadowDepth="0" Opacity="0.55" />
    <DropShadowEffect x:Key="GlowOk" Color="{StaticResource OkColor}" BlurRadius="22" ShadowDepth="0" Opacity="0.6" />
    <DropShadowEffect x:Key="GlowDanger" Color="{StaticResource DangerColor}" BlurRadius="22" ShadowDepth="0" Opacity="0.6" />
    <DropShadowEffect x:Key="CardShadow" Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.45" />

