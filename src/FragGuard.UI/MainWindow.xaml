<Window x:Class="FragGuard.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FragGuard.UI.ViewModels"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="FragGuard" Width="1200" Height="780" MinWidth="1020" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/fragguard.ico"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource BodyFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        StateChanged="Window_StateChanged">

    <!-- Ventana sin el marco de Windows: barra de título propia con el tema neón -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===================== Barra lateral ===================== -->
            <Border Background="{StaticResource NavGradient}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True">
                    <!-- Logo -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,22,0,28">
                        <Image Source="Assets/fragguard.png" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                        <!-- Logotipo: FRA [GG] UARD, con "GG" (good game) en una placa neón -->
                        <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="FRA" FontFamily="{StaticResource HeadingFont}" FontWeight="Bold" FontSize="21"
                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                            <Border CornerRadius="5" Background="{StaticResource AccentGradient}" Padding="4,0,4,1" Margin="2,0,2,0"
                                    VerticalAlignment="Center" Effect="{StaticResource GlowAccent2}">
                                <TextBlock Text="GG" FontFamily="{StaticResource HeadingFont}" FontWeight="Bold" FontSize="21" Foreground="#FF061018" />
                            </Border>
                            <TextBlock Text="UARD" FontFamily="{StaticResource HeadingFont}" FontWeight="Bold" FontSize="21"
                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Pie: modo juego + estado de conexión -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="14,0,14,18">
                        <Border CornerRadius="12" Padding="14,12" Margin="0,0,0,12" Background="{StaticResource Accent2SoftBrush}"
                                BorderBrush="{StaticResource Accent2Brush}" BorderThickness="1"
                                Visibility="{Binding GameModeActive, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconGamepad}" Fill="{StaticResource Accent2Brush}" Width="18" Height="18" Stretch="Uniform"
                                          Effect="{StaticResource GlowAccent2}" />
                                    <TextBlock Text="MODO JUEGO" FontFamily="{StaticResource HeadingFont}" FontWeight="SemiBold"
                                               Foreground="{StaticResource Accent2Brush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding GameModeReason}" Style="{StaticResource Dim}" FontSize="11.5" Margin="0,6,0,0"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="4,0">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource OkBrush}" />
                                                <Setter Property="Effect" Value="{StaticResource GlowOk}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Dim}">
                                        <Setter Property="Text" Value="Servicio desconectado" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Text" Value="Servicio conectado" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="4,8,0,0" Visibility="{Binding IsElevated, Converter={StaticResource BoolToVis}}">
                            <Path Data="{StaticResource IconAdmin}" Fill="{StaticResource WarnBrush}" Width="12" Height="12" Stretch="Uniform" />
                            <TextBlock Text="Modo administrador" Style="{StaticResource Dim}" FontSize="12" Foreground="{StaticResource WarnBrush}" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Navegación -->
                    <StackPanel>
                        <RadioButton Style="{StaticResource NavButton}" Content="Panel" Tag="{StaticResource IconShield}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Dashboard"
                                     IsChecked="{Binding CurrentPageKey, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Dashboard}" />
                        <RadioButton Style="{StaticResource NavButton}" Content="Escanear" Tag="{StaticResource IconRadar}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Scan"
                                     IsChecked="{Binding CurrentPageKey, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Scan}" />
                        <RadioButton Style="{StaticResource NavButton}" Content="Protección" Tag="{StaticResource IconSecurity}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Protection"
                                     IsChecked="{Binding CurrentPageKey, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Protection}" />
                        <RadioButton Style="{StaticResource NavButton}" Content="Cuarentena" Tag="{StaticResource IconLock}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Quarantine"
                                     IsChecked="{Binding CurrentPageKey, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Quarantine}" />
                        <RadioButton Style="{StaticResource NavButton}" Content="Historial" Tag="{StaticResource IconHistory}"
                                     Command="{Binding NavigateCommand}" CommandParameter="History"
                                     IsChecked="{Binding CurrentPageKey, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=History}" />
                        <RadioButton Style="{StaticResource NavButton}" Content="Inicio de Windows" Tag="{StaticResource IconPower}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Autoruns"
                                     IsChecked="{Binding CurrentPageKey, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Autoruns}" />
                        <RadioButton Style="{StaticResource NavButton}" Content="Ajustes" Tag="{StaticResource IconCog}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Settings"
                                     IsChecked="{Binding CurrentPageKey, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Settings}" />
                        <RadioButton Style="{StaticResource NavButton}" Content="Juegos" Tag="{StaticResource IconGamepad}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Games"
                                     IsChecked="{Binding CurrentPageKey, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Games}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ===================== Contenido ===================== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Barra de título (la zona vacía permite arrastrar la ventana) -->
                <TextBlock Text="Antivirus ligero para gamers" Style="{StaticResource Label}" FontSize="12"
                           VerticalAlignment="Center" Margin="32,0,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,8,0">
                    <Button Style="{StaticResource TitleBarButton}" Tag="{StaticResource IconMinimize}" Click="Minimize_Click" ToolTip="Minimizar" />
                    <Button Style="{StaticResource TitleBarCloseButton}" Tag="{StaticResource IconClose}" Click="Close_Click"
                            ToolTip="Cerrar (FragGuard sigue en la bandeja)" Margin="4,0,0,0" />
                </StackPanel>

                <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Focusable="False" />
            </Grid>
        </Grid>
    </Border>
</Window>
