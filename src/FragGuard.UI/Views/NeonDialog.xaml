<Window x:Class="FragGuard.UI.Views.NeonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource BodyFont}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="0" ResizeBorderThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <!-- Diálogo propio con el tema neón (el MessageBox de Windows rompería la estética) -->
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="26,22">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Path x:Name="IconPath" Width="22" Height="22" Stretch="Uniform" Fill="{StaticResource AccentBrush}"
                      Data="{StaticResource IconShield}" VerticalAlignment="Center" />
                <TextBlock x:Name="TitleText" Style="{StaticResource H2}" FontSize="19" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="MessageText" Style="{StaticResource Body}" Foreground="{StaticResource TextDimBrush}"
                       Margin="0,14,0,0" LineHeight="20" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button x:Name="CancelButton" Style="{StaticResource GhostButton}" Margin="0,0,10,0" Click="Cancel_Click" IsCancel="True" />
                <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" Click="Ok_Click" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
