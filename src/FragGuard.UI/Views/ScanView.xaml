<UserControl x:Class="FragGuard.UI.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FragGuard.UI.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:ScanViewModel}"
             Style="{StaticResource PageRoot}">
    <UserControl.RenderTransform>
        <TranslateTransform />
    </UserControl.RenderTransform>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,4,32,32">
            <TextBlock Text="Escanear" Style="{StaticResource H1}" />
            <TextBlock Text="En modo juego, los escaneos manuales siguen en bajo impacto (1 hilo) y los programados esperan a que termines la partida."
                       Style="{StaticResource Dim}" Margin="0,4,0,20" />

            <!-- ===================== Tipos de escaneo ===================== -->
            <UniformGrid Columns="3" Margin="0,0,-14,0" IsEnabled="{Binding IsScanning, Converter={StaticResource Not}}">
                <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" Style="{StaticResource PrimaryButton}" Content="Iniciar" HorizontalAlignment="Left"
                                Margin="0,18,0,0" Command="{Binding QuickScanCommand}" />
                        <StackPanel>
                            <Path Data="{StaticResource IconBolt}" Fill="{StaticResource AccentBrush}" Width="26" Height="26" Stretch="Uniform"
                                  HorizontalAlignment="Left" Effect="{StaticResource GlowAccent}" />
                            <TextBlock Text="Rápido" Style="{StaticResource H2}" FontSize="19" Margin="0,14,0,6" />
                            <TextBlock Style="{StaticResource Dim}" Text="Descargas, Escritorio y carpetas temporales. Donde aparece casi todo el malware. Tarda poco." />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" Style="{StaticResource NeonButton}" Content="Iniciar" HorizontalAlignment="Left"
                                Margin="0,18,0,0" Command="{Binding FullScanCommand}" />
                        <StackPanel>
                            <Path Data="{StaticResource IconDisk}" Fill="{StaticResource AccentBrush}" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Left" />
                            <TextBlock Text="Completo" Style="{StaticResource H2}" FontSize="19" Margin="0,14,0,6" />
                            <TextBlock Style="{StaticResource Dim}" Text="Todos los discos: ejecutables, scripts y comprimidos. Puede tardar; mejor cuando no estés jugando." />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" Style="{StaticResource NeonButton}" HorizontalAlignment="Left"
                                Margin="0,18,0,0" Command="{Binding CustomScanCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconFolder}" Fill="{StaticResource AccentBrush}" Width="13" Height="13" Stretch="Uniform" />
                                <TextBlock Text="Elegir carpeta…" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <StackPanel>
                            <Path Data="{StaticResource IconFolder}" Fill="{StaticResource AccentBrush}" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Left" />
                            <TextBlock Text="Personalizado" Style="{StaticResource H2}" FontSize="19" Margin="0,14,0,6" />
                            <TextBlock Style="{StaticResource Dim}" Text="Una carpeta concreta (mods, un juego descargado...). Se analizan todos los archivos." />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </UniformGrid>

            <!-- ===================== Progreso ===================== -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="24"
                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource NeonButton}" Content="Pausar" Command="{Binding PauseCommand}"
                                    Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            <Button Style="{StaticResource NeonButton}" Content="Reanudar" Command="{Binding ResumeCommand}"
                                    Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource DangerButton}" Content="Cancelar" Margin="10,0,0,0" Command="{Binding CancelCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ScanTitle}" Style="{StaticResource H2}" FontSize="19" />
                            <Border Style="{StaticResource Chip}" Background="{StaticResource WarnSoftBrush}" Margin="12,0,0,0"
                                    Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="EN PAUSA" Foreground="{StaticResource WarnBrush}" FontSize="11" FontFamily="{StaticResource HeadingFont}" />
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <!-- Barra "escáner" neón indeterminada (no sabemos el total de archivos de antemano) -->
                    <Grid Height="4" Margin="0,18,0,0" ClipToBounds="True">
                        <Border Background="{StaticResource Surface3Brush}" CornerRadius="2" />
                        <Rectangle Width="220" HorizontalAlignment="Left" RadiusX="2" RadiusY="2" Fill="{StaticResource AccentGradient}">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                            <Setter Property="Opacity" Value="0.25" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                            <Rectangle.RenderTransform>
                                <TranslateTransform X="-220" />
                            </Rectangle.RenderTransform>
                            <Rectangle.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" From="-220" To="1300" Duration="0:0:1.6">
                                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Rectangle.Triggers>
                        </Rectangle>
                    </Grid>

                    <UniformGrid Columns="4" Margin="0,22,0,0">
                        <StackPanel>
                            <TextBlock Text="ANALIZADOS" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding FilesScanned}" Style="{StaticResource BigNumber}" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="OMITIDOS" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding FilesSkipped}" Style="{StaticResource BigNumber}" Foreground="{StaticResource TextDimBrush}" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="AMENAZAS" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding ThreatsFound}" Margin="0,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BigNumber}">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ThreatsFound}" Value="0">
                                                <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="TIEMPO" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding Elapsed}" Style="{StaticResource BigNumber}" Margin="0,6,0,0" />
                        </StackPanel>
                    </UniformGrid>

                    <TextBlock Text="{Binding CurrentFile}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource TextFaintBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,18,0,0" />
                </StackPanel>
            </Border>

            <!-- ===================== Resultado ===================== -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="22"
                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <Path Width="38" Height="38" Stretch="Uniform" VerticalAlignment="Center">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Data" Value="{StaticResource IconShield}" />
                                <Setter Property="Fill" Value="{StaticResource OkBrush}" />
                                <Setter Property="Effect" Value="{StaticResource GlowOk}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ResultHasThreats}" Value="True">
                                        <Setter Property="Data" Value="{StaticResource IconShieldAlert}" />
                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                        <Setter Property="Effect" Value="{StaticResource GlowDanger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                    <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ResultTitle}" Style="{StaticResource H2}" FontSize="19" />
                        <TextBlock Text="{Binding ResultDetail}" Style="{StaticResource Dim}" Margin="0,4,0,0" />
                        <TextBlock Text="Las amenazas maliciosas se han movido a la cuarentena; las sospechosas aparecen en el Historial."
                                   Style="{StaticResource Dim}" FontSize="12" Margin="0,6,0,0"
                                   Visibility="{Binding ResultHasThreats, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
