<UserControl x:Class="FragGuard.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FragGuard.UI.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             Style="{StaticResource PageRoot}">
    <UserControl.RenderTransform>
        <TranslateTransform />
    </UserControl.RenderTransform>

    <UserControl.Resources>
        <!-- Lista de carpetas con botón "quitar" -->
        <DataTemplate x:Key="FolderRow">
            <Border Background="{StaticResource Surface2Brush}" CornerRadius="8" Padding="12,6" Margin="0,0,0,6">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="6" ToolTip="Quitar"
                            Command="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                        <Path Data="{StaticResource IconClose}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="10" Height="10" Stretch="Uniform" />
                    </Button>
                    <Path Data="{StaticResource IconFolder}" Fill="{StaticResource AccentBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>
        </DataTemplate>
        <Style x:Key="Section" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Padding" Value="22,18" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,4,32,16" MaxWidth="880" HorizontalAlignment="Left">
                <TextBlock Text="Ajustes" Style="{StaticResource H1}" />
                <TextBlock Text="Los cambios se aplican en el servicio al pulsar «Guardar cambios»." Style="{StaticResource Dim}" Margin="0,4,0,16" />

                <Border CornerRadius="12" Padding="16,12" Margin="0,0,0,16" Background="{StaticResource WarnSoftBrush}"
                        BorderBrush="{StaticResource WarnBrush}" BorderThickness="1"
                        Visibility="{Binding IsElevated, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource WarnButton}" Content="Reabrir como administrador" Command="{Binding ElevateNowCommand}" />
                        <Path Data="{StaticResource IconAdmin}" Fill="{StaticResource WarnBrush}" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource Body}" VerticalAlignment="Center" Margin="12,0,16,0"
                                   Text="Guardar cambios requiere permisos de administrador: así ningún programa puede desactivar FragGuard a tus espaldas." />
                    </DockPanel>
                </Border>

                <TextBlock Text="No se pudo cargar la configuración: el servicio no está disponible." Style="{StaticResource Dim}"
                           Foreground="{StaticResource DangerBrush}" Margin="0,0,0,16"
                           Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

                <StackPanel IsEnabled="{Binding IsLoaded}">
                    <!-- ===== Tiempo real ===== -->
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="Protección en tiempo real" Style="{StaticResource H2}" />
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding RealtimeEnabled}" Margin="0,12,0,0"
                                      Content="Analizar al momento los archivos nuevos de Descargas y de las carpetas vigiladas" />
                            <TextBlock Text="EXTENSIONES ANALIZADAS" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding RealtimeExtensions, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="CARPETAS VIGILADAS ADEMÁS DE DESCARGAS (MODS, JUEGOS DESCARGADOS...)" Style="{StaticResource FieldLabel}" />
                            <ItemsControl ItemsSource="{Binding WatchedFolders}" ItemTemplate="{StaticResource FolderRow}" Tag="{Binding RemoveWatchedFolderCommand}" />
                            <Button Style="{StaticResource NeonButton}" HorizontalAlignment="Left" Margin="0,4,0,0" Command="{Binding AddWatchedFolderCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconFolder}" Fill="{StaticResource AccentBrush}" Width="13" Height="13" Stretch="Uniform" />
                                    <TextBlock Text="Añadir carpeta" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- ===== Detección ===== -->
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="Detección" Style="{StaticResource H2}" />
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoQuarantine}" Margin="0,12,0,0"
                                      Content="Mover a cuarentena automáticamente las amenazas maliciosas (las sospechosas solo se avisan)" />
                            <TextBlock Text="TAMAÑO MÁXIMO DE ARCHIVO A ANALIZAR (MB)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding MaxFileSizeMb, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" />
                            <TextBlock Text="EXCLUSIONES (CARPETAS QUE NO SE ANALIZAN)" Style="{StaticResource FieldLabel}" />
                            <ItemsControl ItemsSource="{Binding Exclusions}" ItemTemplate="{StaticResource FolderRow}" Tag="{Binding RemoveExclusionCommand}" />
                            <Button Style="{StaticResource NeonButton}" HorizontalAlignment="Left" Margin="0,4,0,0" Content="Añadir exclusión" Command="{Binding AddExclusionCommand}" />
                        </StackPanel>
                    </Border>

                    <!-- ===== VirusTotal ===== -->
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="VirusTotal" Style="{StaticResource H2}" />
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding VirusTotalEnabled}" Margin="0,12,0,0"
                                      Content="Consultar el hash SHA-256 de ejecutables y comprimidos (nunca se suben tus archivos)" />
                            <TextBlock Text="CLAVE API" Style="{StaticResource FieldLabel}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Borrar clave" Margin="8,0,0,0"
                                        Command="{Binding ClearVirusTotalKeyCommand}" Visibility="{Binding HasVirusTotalKey, Converter={StaticResource BoolToVis}}" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource NeonButton}" Content="Guardar clave" Margin="8,0,0,0" Command="{Binding SaveVirusTotalKeyCommand}" />
                                <PasswordBox x:Name="VtKeyBox" PasswordChanged="VtKeyBox_PasswordChanged" />
                            </DockPanel>
                            <TextBlock Margin="0,8,0,0" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Dim}">
                                        <Setter Property="Text" Value="Sin clave. Crea una cuenta gratuita en virustotal.com y copia tu API key. Plan gratuito: 4 consultas/min y 500/día." />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasVirusTotalKey}" Value="True">
                                                <Setter Property="Text" Value="Clave guardada y cifrada en este equipo (DPAPI). No se vuelve a mostrar." />
                                                <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- ===== Modo juego ===== -->
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconGamepad}" Fill="{StaticResource Accent2Brush}" Width="20" Height="20" Stretch="Uniform" />
                                <TextBlock Text="Modo juego" Style="{StaticResource H2}" Margin="10,0,0,0" />
                            </StackPanel>
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding GameModeAuto}" Margin="0,12,0,0"
                                      Content="Activar automáticamente al detectar un juego (lista de juegos o juego lanzado desde Steam, Epic, Battle.net, Riot...)" />
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding GameModeOnFullscreen}"
                                      Content="Activarlo también con cualquier aplicación a pantalla completa" />
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding SilenceNonCriticalInGameMode}"
                                      Content="Silenciar las notificaciones no críticas mientras juego" />
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="JUEGOS (UNO POR LÍNEA)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding GameProcesses, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="150"
                                             VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="NoWrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="LANZADORES (UNO POR LÍNEA)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding LauncherProcesses, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="150"
                                             VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="NoWrap" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ===== Escaneo programado ===== -->
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="Escaneo programado" Style="{StaticResource H2}" />
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ScheduledScanEnabled}" Margin="0,12,0,0"
                                      Content="Escaneo rápido diario (si estás jugando, espera a que termines)" />
                            <TextBlock Text="HORA (HH:mm)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ScheduledScanTime, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Aplicación (local, no requiere administrador) ===== -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="Aplicación" Style="{StaticResource H2}" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartWithWindows}" Margin="0,12,0,0"
                                  Content="Iniciar FragGuard con Windows (en la bandeja, sin abrir la ventana)" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ===================== Barra de guardado ===================== -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="32,14">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButton}" Content="Guardar cambios" Command="{Binding SaveCommand}" IsEnabled="{Binding IsLoaded}" />
                <TextBlock Text="{Binding SaveMessage}" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="13">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SaveOk}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
