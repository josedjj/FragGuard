<UserControl x:Class="FragGuard.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FragGuard.UI.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             Style="{StaticResource PageRoot}">
    <UserControl.RenderTransform>
        <TranslateTransform />
    </UserControl.RenderTransform>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,4,32,32">
            <TextBlock Text="Panel" Style="{StaticResource H1}" />
            <TextBlock Text="{Binding UptimeText}" Style="{StaticResource Dim}" Margin="0,4,0,20" />

            <!-- ===================== Estado + modo juego ===================== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="26" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Escudo con anillo que "late" suavemente -->
                        <Grid Width="128" Height="128" VerticalAlignment="Center">
                            <Ellipse x:Name="PulseRing" StrokeThickness="2" Opacity="0.3" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform />
                                </Ellipse.RenderTransform>
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Stroke" Value="{StaticResource OkBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                <Setter Property="Stroke" Value="{StaticResource WarnBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Disconnected">
                                                <Setter Property="Stroke" Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.15" To="0.75" Duration="0:0:1.8" />
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" From="0.92" To="1.04" Duration="0:0:1.8" />
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" From="0.92" To="1.04" Duration="0:0:1.8" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <Ellipse Margin="16" Fill="{StaticResource Surface2Brush}" />
                            <Path Width="54" Height="54" Stretch="Uniform">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="{StaticResource IconShield}" />
                                        <Setter Property="Fill" Value="{StaticResource OkBrush}" />
                                        <Setter Property="Effect" Value="{StaticResource GlowOk}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                <Setter Property="Data" Value="{StaticResource IconShieldAlert}" />
                                                <Setter Property="Fill" Value="{StaticResource WarnBrush}" />
                                                <Setter Property="Effect" Value="{x:Null}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Disconnected">
                                                <Setter Property="Data" Value="{StaticResource IconShieldAlert}" />
                                                <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                                <Setter Property="Effect" Value="{StaticResource GlowDanger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="28,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusTitle}" Style="{StaticResource H1}" FontSize="30" />
                            <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Dim}" FontSize="13.5" Margin="0,6,0,14" />
                            <WrapPanel>
                                <Border Style="{StaticResource Chip}" Margin="0,0,8,8">
                                    <TextBlock Text="{Binding RealtimeText}" Foreground="{StaticResource AccentBrush}" FontSize="12" />
                                </Border>
                                <Border Style="{StaticResource Chip}" Margin="0,0,8,8">
                                    <TextBlock Text="{Binding RulesText}" Foreground="{StaticResource AccentBrush}" FontSize="12" />
                                </Border>
                                <Border Style="{StaticResource Chip}" Margin="0,0,8,8">
                                    <TextBlock Text="{Binding VirusTotalText}" Foreground="{StaticResource AccentBrush}" FontSize="12" />
                                </Border>
                            </WrapPanel>
                            <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                    Command="{Binding QuickScanCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconBolt}" Fill="#FF061018" Width="14" Height="14" Stretch="Uniform" />
                                    <TextBlock Text="Escaneo rápido" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Modo juego -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22">
                    <StackPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconGamepad}" Width="22" Height="22" Stretch="Uniform">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Fill" Value="{StaticResource TextFaintBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GameModeActive}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource Accent2Brush}" />
                                                <Setter Property="Effect" Value="{StaticResource GlowAccent2}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock Text="MODO JUEGO" Style="{StaticResource Label}" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock FontSize="34" Margin="0,14,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource BigNumber}">
                                    <Setter Property="Text" Value="Inactivo" />
                                    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GameModeActive}" Value="True">
                                            <Setter Property="Text" Value="Activo" />
                                            <Setter Property="Foreground" Value="{StaticResource Accent2Brush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding GameModeReason}" Style="{StaticResource Dim}" Margin="0,4,0,0"
                                   Visibility="{Binding GameModeActive, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Style="{StaticResource Dim}" FontSize="12" Margin="0,12,0,0"
                                   Text="Se activa solo al jugar: pausa escaneos programados, silencia avisos no críticos y baja la prioridad de FragGuard." />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===================== Indicadores ===================== -->
            <UniformGrid Columns="4" Margin="0,16,-12,0">
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="ÚLTIMO ESCANEO" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding LastScanTitle}" Style="{StaticResource BigNumber}" FontSize="20" Margin="0,12,0,6"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding LastScanTitle}" />
                        <TextBlock Text="{Binding LastScanDetail}" Style="{StaticResource Dim}" FontSize="12" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="AMENAZAS BLOQUEADAS" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding ThreatsBlocked}" Style="{StaticResource BigNumber}" Foreground="{StaticResource Accent2Brush}" Margin="0,8,0,2" />
                        <TextBlock Text="desde la instalación" Style="{StaticResource Dim}" FontSize="12" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="EN CUARENTENA" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding QuarantineCount}" Style="{StaticResource BigNumber}" Margin="0,8,0,2" />
                        <TextBlock Text="archivos aislados y cifrados" Style="{StaticResource Dim}" FontSize="12" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconChip}" Fill="{StaticResource AccentBrush}" Width="13" Height="13" Stretch="Uniform" />
                            <TextBlock Text="CONSUMO DE FRAGGUARD" Style="{StaticResource Label}" Margin="6,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding RamText}" Style="{StaticResource BigNumber}" FontSize="24" Margin="0,10,0,8" />
                        <ProgressBar Style="{StaticResource NeonMeter}" Value="{Binding RamPercent, Mode=OneWay}" ToolTip="RAM del servicio frente al objetivo de 50 MB" />
                        <TextBlock Style="{StaticResource Dim}" FontSize="12" Margin="0,8,0,0">
                            <Run Text="CPU" /> <Run Text="{Binding CpuText, Mode=OneWay}" Foreground="{StaticResource TextBrush}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ===================== Actividad reciente ===================== -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Limpiar" Command="{Binding ClearAlertsCommand}"
                                Visibility="{Binding HasAlerts, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="Actividad reciente" Style="{StaticResource H2}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="Sin incidencias en esta sesión. Las amenazas y avisos aparecerán aquí en tiempo real."
                               Style="{StaticResource Dim}" Margin="0,12,0,0"
                               Visibility="{Binding HasAlerts, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

                    <ItemsControl ItemsSource="{Binding Alerts}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AlertItem}">
                                <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="14,12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="4" CornerRadius="2" Margin="0,0,14,0" Background="{Binding Kind, Converter={StaticResource SeverityBrush}}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Dim}" FontSize="12" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding FilePath}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource TextFaintBrush}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TimeText}" Style="{StaticResource Dim}" FontSize="11.5" HorizontalAlignment="Right" />
                                            <Button Style="{StaticResource DangerButton}" Content="Cerrar proceso" Margin="0,8,0,0" Padding="12,5"
                                                    Visibility="{Binding CanKill, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.KillProcessCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
