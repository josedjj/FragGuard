<UserControl x:Class="FragGuard.UI.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FragGuard.UI.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:GamesViewModel}"
             Style="{StaticResource PageRoot}">
    <UserControl.RenderTransform>
        <TranslateTransform />
    </UserControl.RenderTransform>

    <UserControl.Resources>
        <!-- Botón de orden en forma de "chip" (RadioButton) -->
        <Style x:Key="SortChip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="8" Padding="12,6" Background="Transparent" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,4,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ReloadCommand}" VerticalAlignment="Top" ToolTip="Volver a buscar juegos">
                <Path Data="{StaticResource IconRefresh}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform" />
            </Button>
            <StackPanel>
                <TextBlock Text="Juegos" Style="{StaticResource H1}" />
                <TextBlock Text="Tus juegos instalados, cuándo los abriste por última vez y cuánto ocupan." Style="{StaticResource Dim}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Buscador, orden y resumen -->
        <StackPanel Grid.Row="1" Margin="0,16,0,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ORDEN" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <RadioButton Style="{StaticResource SortChip}" GroupName="Sort" Content="Recientes"
                                 IsChecked="{Binding SortMode, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Recent}"
                                 Command="{Binding SetSortCommand}" CommandParameter="Recent" />
                    <RadioButton Style="{StaticResource SortChip}" GroupName="Sort" Content="Nombre"
                                 IsChecked="{Binding SortMode, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Name}"
                                 Command="{Binding SetSortCommand}" CommandParameter="Name" />
                    <RadioButton Style="{StaticResource SortChip}" GroupName="Sort" Content="Tamaño"
                                 IsChecked="{Binding SortMode, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Size}"
                                 Command="{Binding SetSortCommand}" CommandParameter="Size" />
                </StackPanel>
                <Grid Width="320" HorizontalAlignment="Left">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="34,8,10,8" />
                    <Path Data="{StaticResource IconSearch}" Fill="{StaticResource TextFaintBrush}" Width="14" Height="14" Stretch="Uniform"
                          HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False" />
                    <TextBlock Text="Buscar juego o plataforma…" Foreground="{StaticResource TextFaintBrush}" FontSize="13" Margin="36,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding SearchText, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
                </Grid>
            </DockPanel>
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Dim}" Margin="0,12,0,0" />
        </StackPanel>

        <!-- Estados vacíos -->
        <TextBlock Grid.Row="2" Text="Buscando juegos en Steam, Epic, Riot, EA, Ubisoft, GOG y Battle.net…" Style="{StaticResource Dim}" FontSize="14"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding LoadedOnce, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding LoadedOnce}" Value="True" />
                                <Condition Binding="{Binding HasGames}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Path Data="{StaticResource IconGamepad}" Fill="{StaticResource Surface3Brush}" Width="64" Height="64" Stretch="Uniform" />
            <TextBlock Text="No se encontraron juegos" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,16,0,0" />
        </StackPanel>

        <!-- Lista de juegos -->
        <ListBox Grid.Row="2" Style="{StaticResource CleanList}" ItemsSource="{Binding View}"
                 Visibility="{Binding HasGames, Converter={StaticResource BoolToVis}}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:GameItem}">
                    <Border Style="{StaticResource Card}" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Portada (Steam) / icono / inicial -->
                            <Grid Width="56" Height="80">
                                <Border CornerRadius="8" Background="{StaticResource Surface3Brush}" />
                                <TextBlock Text="{Binding Initial}" FontFamily="{StaticResource HeadingFont}" FontWeight="Bold" FontSize="26"
                                           Foreground="{Binding Launcher, Converter={StaticResource LauncherBrush}}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding Icon}" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality" />
                                <Border CornerRadius="8" Visibility="{Binding Cover, Converter={StaticResource NullToVis}}">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                            </Grid>

                            <!-- Datos -->
                            <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" FontSize="16" TextTrimming="CharacterEllipsis" />
                                <WrapPanel Margin="0,8,0,0">
                                    <Border CornerRadius="6" Padding="8,2" Margin="0,0,10,0" BorderThickness="1"
                                            BorderBrush="{Binding Launcher, Converter={StaticResource LauncherBrush}}">
                                        <TextBlock Text="{Binding Launcher}" FontSize="11" FontFamily="{StaticResource HeadingFont}"
                                                   Foreground="{Binding Launcher, Converter={StaticResource LauncherBrush}}" />
                                    </Border>
                                    <TextBlock Text="{Binding LastPlayedText}" ToolTip="{Binding LastPlayedTooltip}" FontSize="12.5"
                                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding SizeText}" Style="{StaticResource Dim}" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <Border Style="{StaticResource Chip}" Background="{StaticResource WarnSoftBrush}"
                                            Visibility="{Binding IsStale, Converter={StaticResource BoolToVis}}"
                                            ToolTip="Hace más de 90 días que no lo abres: podrías desinstalarlo para liberar espacio.">
                                        <TextBlock Text="Sin jugar en +90 días" Foreground="{StaticResource WarnBrush}" FontSize="11" />
                                    </Border>
                                </WrapPanel>
                                <TextBlock Text="{Binding Dto.InstallPath}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource TextFaintBrush}"
                                           TextTrimming="CharacterEllipsis" Margin="0,8,0,0" ToolTip="{Binding Dto.InstallPath}" />
                            </StackPanel>

                            <!-- Acciones -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource GhostButton}" ToolTip="Abrir carpeta" Margin="0,0,6,0" Padding="9"
                                        Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}">
                                    <Path Data="{StaticResource IconFolder}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="15" Height="15" Stretch="Uniform" />
                                </Button>
                                <Button Style="{StaticResource DangerButton}" Padding="12,7" Margin="0,0,8,0" IsEnabled="{Binding CanUninstall}"
                                        Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconTrash}" Fill="{StaticResource DangerBrush}" Width="13" Height="13" Stretch="Uniform" />
                                        <TextBlock Text="Desinstalar" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource PrimaryButton}" Padding="18,8" IsEnabled="{Binding CanPlay}"
                                        Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconGamepad}" Fill="#FF061018" Width="15" Height="15" Stretch="Uniform" />
                                        <TextBlock Text="Jugar" Margin="7,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
