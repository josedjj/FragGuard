<Window x:Class="FragGuard.UI.Views.GameCleanupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:FragGuard.UI.Infrastructure"
        Width="760" Height="560" MinHeight="420"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource BodyFont}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" GlassFrameThickness="0" ResizeBorderThickness="6" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid Margin="26,20,26,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconTrash}" Fill="{StaticResource AccentBrush}" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBlock x:Name="TitleText" Style="{StaticResource H2}" FontSize="20" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Style="{StaticResource Dim}" Margin="0,8,0,0"
                           Text="Carpetas que llevan exactamente el nombre del juego. Lo marcado irá a la Papelera (recuperable). Las que pueden contener partidas guardadas vienen desmarcadas: revísalas antes de borrarlas." />
            </StackPanel>

            <!-- Aviso si el juego aún parece instalado -->
            <Border x:Name="StillInstalledBanner" Grid.Row="1" CornerRadius="10" Padding="14,10" Margin="0,14,0,0" Visibility="Collapsed"
                    Background="{StaticResource WarnSoftBrush}" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1">
                <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource WarnBrush}"
                           Text="El juego sigue apareciendo como instalado: no se incluye su carpeta de instalación. Si la desinstalación aún no ha terminado, cierra esto y vuelve a intentarlo después." />
            </Border>

            <!-- Lista de restos -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <TextBlock x:Name="EmptyText" Style="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"
                           Text="No se encontraron restos. ¡Todo limpio!" Visibility="Collapsed" />
                <ListBox x:Name="ItemsList" Style="{StaticResource CleanList}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type infra:LeftoverItem}">
                            <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Path}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Border Style="{StaticResource Chip}" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Category}" Foreground="{StaticResource AccentBrush}" FontSize="11" />
                                            </Border>
                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource Dim}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding Note}" FontSize="12" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Dim}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MayContainSaves}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsSelected}"
                                              VerticalAlignment="Center" Margin="16,0,0,0" Checked="Selection_Changed" Unchecked="Selection_Changed" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- Pie -->
            <DockPanel Grid.Row="3" Margin="0,16,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="CancelButton" Style="{StaticResource GhostButton}" Content="Cerrar" Margin="0,0,10,0" Click="Cancel_Click" IsCancel="True" />
                    <Button x:Name="DeleteButton" Style="{StaticResource DangerButton}" Click="Delete_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconTrash}" Fill="{StaticResource DangerBrush}" Width="13" Height="13" Stretch="Uniform" />
                            <TextBlock Text="Mover a la Papelera" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Button x:Name="SelectAllButton" Style="{StaticResource GhostButton}" Content="Seleccionar todo" Click="SelectAll_Click" />
                <TextBlock x:Name="TotalText" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="14,0,0,0" />
            </DockPanel>
        </Grid>
    </Border>
</Window>
