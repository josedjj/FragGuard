<Project Sdk="Microsoft.NET.Sdk">

  <!-- Interfaz de FragGuard (WPF). Solo depende de Shared: nunca analiza nada, habla con el servicio por el pipe. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>FragGuard.UI</RootNamespace>
    <AssemblyName>FragGuard</AssemblyName>
    <ApplicationIcon>Assets\fragguard.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- La UI vive en la bandeja: GC de estación de trabajo y conservador con la memoria -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <GCConserveMemory>5</GCConserveMemory>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.2" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FragGuard.Shared\FragGuard.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\fragguard.ico" />
    <Resource Include="Assets\fragguard.png" />
  </ItemGroup>

</Project>
