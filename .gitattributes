# Finales de línea normalizados en el repositorio; en Windows se usan CRLF al hacer checkout.
* text=auto

# Scripts de PowerShell y archivos de solución de Visual Studio: siempre CRLF.
*.ps1 text eol=crlf
*.sln text eol=crlf

# Binarios
*.ico binary
*.png binary

# Canal de reglas firmado: los bytes deben quedar EXACTAMENTE como se firmaron (sin conversión de fin de línea).
rules-channel/** -text
